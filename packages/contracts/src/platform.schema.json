{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:c2k:platform:1",
  "$defs": {
    "Session": {
      "description": "浏览器会话公开身份，不包含凭证，不代表知识阅读授权。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "username",
        "displayName",
        "tenantName",
        "role",
        "permissions",
        "navigation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "身份UUID，不为空。"
        },
        "username": {
          "type": "string",
          "description": "部署内唯一登录名，不为空。"
        },
        "displayName": {
          "type": "string",
          "description": "显示名称，不为空。"
        },
        "tenantName": {
          "type": "string",
          "description": "企业名称，不为空。"
        },
        "role": {
          "type": "string",
          "description": "受保护基础身份，不用于判断当前管理动作；自定义角色动作见permissions。",
          "enum": [
            "ADMIN",
            "MEMBER"
          ]
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "当前动作集合，只为界面提示；服务端逐请求重查。"
        },
        "navigation": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "$ref": "#/$defs/Navigation"
          },
          "description": "当前动作授权的页面目录；空数组表示无可用功能。"
        }
      }
    },
    "Member": {
      "description": "企业成员管理视图，禁止返回密码摘要。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "username",
        "displayName",
        "role",
        "enabled"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "成员UUID，不为空。"
        },
        "username": {
          "type": "string",
          "description": "登录名，不为空。"
        },
        "displayName": {
          "type": "string",
          "description": "显示名称，不为空。"
        },
        "role": {
          "type": "string",
          "description": "受保护基础身份ADMIN或MEMBER，不代表全部附加角色。",
          "enum": [
            "ADMIN",
            "MEMBER"
          ]
        },
        "enabled": {
          "type": "boolean",
          "description": "启用状态，不为空。"
        }
      }
    },
    "CatalogSystem": {
      "description": "目录元数据，catalog.read不代表来源或知识读取。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "系统UUID，不为空。"
        },
        "name": {
          "type": "string",
          "description": "系统名称，不为空。"
        },
        "description": {
          "type": "string",
          "description": "目录描述，允许空字符串。"
        }
      }
    },
    "Grant": {
      "description": "单系统目录读取授权，不代表知识授权。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "displayName",
        "action"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "description": "普通成员UUID，不为空。"
        },
        "displayName": {
          "type": "string",
          "description": "成员显示名，不为空。"
        },
        "action": {
          "type": "string",
          "description": "仅目录读取动作。",
          "enum": [
            "catalog.read"
          ]
        }
      }
    },
    "Csrf": {
      "description": "当前会话写保护令牌，不是访问令牌。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "headerName",
        "token"
      ],
      "properties": {
        "headerName": {
          "type": "string",
          "description": "写请求头名称，不为空。"
        },
        "token": {
          "type": "string",
          "description": "CSRF令牌，不记录日志。"
        }
      }
    },
    "ApiError": {
      "description": "不含敏感正文的稳定HTTP错误。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "稳定错误码。"
        },
        "message": {
          "type": "string",
          "description": "中文恢复提示。"
        }
      }
    },
    "Device": {
      "description": "所有者私有设备视图，不含凭证；仅接入健康不代表可执行任务。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "os",
        "arch",
        "version",
        "status",
        "lastSeen"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "设备UUID，不为空。"
        },
        "name": {
          "type": "string",
          "description": "所有者指定名称，不为空。"
        },
        "os": {
          "type": "string",
          "description": "自报操作系统，不作为信任证明。"
        },
        "arch": {
          "type": "string",
          "description": "自报CPU架构，不作为信任证明。"
        },
        "version": {
          "type": "string",
          "description": "运行时协议客户端版本，不为空。"
        },
        "status": {
          "type": "string",
          "description": "心跳派生状态，撤销或停用优先。",
          "enum": [
            "ONLINE",
            "OFFLINE",
            "REVOKED"
          ]
        },
        "lastSeen": {
          "type": "string",
          "description": "最近心跳ISO时间；未发送心跳为空字符串。"
        }
      }
    },
    "Pairing": {
      "description": "短时单次配对资料，仅创建时返回原码，禁止日志记录。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "配对会话UUID，不为空。"
        },
        "code": {
          "type": "string",
          "description": "256位随机配对码，仅用于标准输入，禁止放命令参数。"
        },
        "expiresAt": {
          "type": "string",
          "description": "配对有效期ISO时间，5分钟后拒绝。"
        }
      }
    },
    "DeviceCredential": {
      "description": "配对兑换成功，仅设备本地持久化，禁止日志和浏览器展示。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "token",
        "expiresAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "新设备UUID，不为空。"
        },
        "token": {
          "type": "string",
          "description": "设备专用256位凭证，仅授予心跳，不授予浏览器业务访问。"
        },
        "expiresAt": {
          "type": "string",
          "description": "设备凭证过期ISO时间，30天后需要重新配对。"
        }
      }
    },
    "Heartbeat": {
      "description": "设备认证后心跳确认，服务端时钟为状态事实源。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "serverTime"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "当前设备UUID，不为空。"
        },
        "status": {
          "type": "string",
          "description": "当前设备状态。",
          "enum": [
            "ONLINE"
          ]
        },
        "serverTime": {
          "type": "string",
          "description": "服务端ISO时间，不为空。"
        }
      }
    },
    "Permission": {
      "description": "已实现动作目录，未知或未来动作不能配置。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "description"
      ],
      "properties": {
        "code": {
          "type": "string",
          "description": "稳定动作码。"
        },
        "name": {
          "type": "string",
          "description": "动作名称。"
        },
        "description": {
          "type": "string",
          "description": "实际能力和边界。"
        }
      }
    },
    "Role": {
      "description": "角色与动作，内置角色受保护，不自动获得内容读取权。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "builtIn",
        "revision",
        "permissions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "角色ID。"
        },
        "name": {
          "type": "string",
          "description": "角色名称。"
        },
        "description": {
          "type": "string",
          "description": "职责说明，可空串。"
        },
        "builtIn": {
          "type": "boolean",
          "description": "只读基础角色标志。"
        },
        "revision": {
          "type": "integer",
          "description": "并发编辑版本，非负。",
          "minimum": 0
        },
        "permissions": {
          "type": "array",
          "description": "显式动作数组，可为空。",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "MemberRoles": {
      "description": "成员附加角色分配，基础身份不受此入口修改。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "roleIds"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "description": "并发分配版本，非负。",
          "minimum": 0
        },
        "roleIds": {
          "type": "array",
          "description": "同企业自定义角色数组，空表示无附加角色。",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "Source": {
      "description": "来源公开元数据，不含正文；canAnalyze只代表当前资格，不证明远端或文件可访问。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "locator",
        "branch",
        "enabled",
        "revision",
        "canAnalyze"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "稳定来源UUID。"
        },
        "name": {
          "type": "string",
          "description": "来源名称。"
        },
        "kind": {
          "type": "string",
          "description": "仓库或资料类型。",
          "enum": [
            "REPOSITORY",
            "DOCUMENT"
          ]
        },
        "locator": {
          "type": "string",
          "description": "无凭证Git地址或运行时相对资料路径。"
        },
        "branch": {
          "type": "string",
          "description": "默认分析分支，资料为空字符串。"
        },
        "enabled": {
          "type": "boolean",
          "description": "当前是否启用。"
        },
        "revision": {
          "type": "integer",
          "description": "配置版本，非负。",
          "minimum": 0
        },
        "canAnalyze": {
          "type": "boolean",
          "description": "同时有动作和当前版本资源授权。"
        }
      }
    },
    "SourcePage": {
      "description": "服务端授权过滤后分页，每页20项。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "description": "当前页可见来源。",
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        "page": {
          "type": "integer",
          "description": "页码，从1开始。",
          "minimum": 1
        },
        "total": {
          "type": "integer",
          "description": "仅当前主体可见数量，非负。",
          "minimum": 0
        }
      }
    },
    "SourceGrant": {
      "description": "来源成员资源授权，不自动获得角色动作或设备使用权。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memberId",
        "displayName",
        "sourceRevision",
        "current"
      ],
      "properties": {
        "memberId": {
          "type": "string",
          "description": "同企业成员UUID。"
        },
        "displayName": {
          "type": "string",
          "description": "成员公开名称。"
        },
        "sourceRevision": {
          "type": "integer",
          "description": "授权对应的配置版本。",
          "minimum": 0
        },
        "current": {
          "type": "boolean",
          "description": "来源启用且授权版本仍匹配。"
        }
      }
    },
    "SourceCheck": {
      "description": "本次资格检查结果，不是可复用票据，不执行逆向。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "revision",
        "allowed"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "description": "来源UUID。"
        },
        "revision": {
          "type": "integer",
          "description": "本次核对配置版本。",
          "minimum": 0
        },
        "allowed": {
          "type": "boolean",
          "description": "本次检查通过。",
          "const": true
        }
      }
    },
    "Task": {
      "description": "私有来源预检及当前尝试，不代表逆向完成或业务发布。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceId",
        "sourceName",
        "sourceRevision",
        "branch",
        "deviceId",
        "deviceName",
        "name",
        "revision",
        "attemptNumber",
        "attemptId",
        "state",
        "commitId",
        "archiveSha256",
        "fileCount",
        "archiveBytes",
        "message",
        "createdAt",
        "updatedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "任务稳定UUID。"
        },
        "sourceId": {
          "type": "string",
          "description": "已授权仓库来源UUID。"
        },
        "sourceName": {
          "type": "string",
          "description": "创建时来源名称快照，不随目录改名。"
        },
        "sourceRevision": {
          "type": "integer",
          "description": "创建时来源配置版本，变化后拒绝执行。",
          "minimum": 0
        },
        "branch": {
          "type": "string",
          "description": "明确选择的本地Git分支，不代表远端最新。"
        },
        "deviceId": {
          "type": "string",
          "description": "所有者私有设备UUID。"
        },
        "deviceName": {
          "type": "string",
          "description": "创建时设备名快照。"
        },
        "name": {
          "type": "string",
          "description": "预检任务名称，不含脚本。"
        },
        "revision": {
          "type": "integer",
          "description": "任务控制版本，用于并发取消或重试。",
          "minimum": 0
        },
        "attemptNumber": {
          "type": "integer",
          "description": "当前尝试序号，从1开始。",
          "minimum": 0
        },
        "attemptId": {
          "type": "string",
          "description": "当前执行尝试UUID。"
        },
        "state": {
          "type": "string",
          "description": "当前尝试状态：QUEUED/RUNNING/SUCCEEDED/FAILED/CANCELLED/EXPIRED。"
        },
        "commitId": {
          "type": "string",
          "description": "固定Git完整commit，未完成为空字符串。"
        },
        "archiveSha256": {
          "type": "string",
          "description": "本地隔离归档摘要，未完成为空字符串。"
        },
        "fileCount": {
          "type": "integer",
          "description": "已提交树中的条目数，未完成为0。",
          "minimum": 0
        },
        "archiveBytes": {
          "type": "integer",
          "description": "本地隔离归档字节数，未完成为0。",
          "minimum": 0
        },
        "message": {
          "type": "string",
          "description": "固定可公开状态说明，不接受任意设备日志。"
        },
        "createdAt": {
          "type": "string",
          "description": "任务UTC创建时间。"
        },
        "updatedAt": {
          "type": "string",
          "description": "本次尝试UTC更新时间。"
        }
      }
    },
    "TaskPage": {
      "description": "本人任务分页，不含隐藏数量。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "page",
        "total"
      ],
      "properties": {
        "items": {
          "type": "array",
          "description": "当前页任务。",
          "items": {
            "$ref": "#/$defs/Task"
          }
        },
        "page": {
          "type": "integer",
          "description": "从1开始页码。",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "description": "当前成员任务数量。",
          "minimum": 0
        }
      }
    },
    "TaskLease": {
      "description": "设备当前领取租约，不进入浏览器或日志。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available",
        "taskId",
        "attemptId",
        "leaseId",
        "fence",
        "sourceId",
        "sourceRevision",
        "branch"
      ],
      "properties": {
        "available": {
          "type": "boolean",
          "description": "是否领取到任务；false时其余文本为空、fence和sourceRevision为0。"
        },
        "taskId": {
          "type": "string",
          "description": "任务UUID，无任务为空。"
        },
        "attemptId": {
          "type": "string",
          "description": "本次尝试UUID，无任务为空。"
        },
        "leaseId": {
          "type": "string",
          "description": "本次租约标识，不落日志。"
        },
        "fence": {
          "type": "integer",
          "description": "尝试序号，旧尝试不能提交。",
          "minimum": 0
        },
        "sourceId": {
          "type": "string",
          "description": "本机必须显式绑定的来源UUID。"
        },
        "sourceRevision": {
          "type": "integer",
          "description": "本机来源绑定必须匹配的配置版本。",
          "minimum": 0
        },
        "branch": {
          "type": "string",
          "description": "只解析该本地分支，不联网、不切换工作区。"
        }
      }
    },
    "TaskAck": {
      "description": "服务端租约确认，false必须终止。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "state"
      ],
      "properties": {
        "valid": {
          "type": "boolean",
          "description": "当前租约与策略是否仍有效。"
        },
        "state": {
          "type": "string",
          "description": "本次服务端确认状态，无可见任务时REJECTED。"
        }
      }
    },
    "PreflightManifest": {
      "description": "本地隔离预检输出，无源码、文件名和宿主定位。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "commitId",
        "archiveSha256",
        "fileCount",
        "archiveBytes",
        "failureCode"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "description": "本地执行终态。"
        },
        "commitId": {
          "type": "string",
          "description": "固定commit；失败为空。"
        },
        "archiveSha256": {
          "type": "string",
          "description": "隔离归档SHA256；失败为空。"
        },
        "fileCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "description": "树条目数。"
        },
        "archiveBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456,
          "description": "隔离归档字节。"
        },
        "failureCode": {
          "type": "string",
          "enum": [
            "",
            "BINDING_REQUIRED",
            "SOURCE_CHANGED",
            "PREFLIGHT_FAILED"
          ],
          "description": "固定失败码，不传日志。"
        }
      }
    },
    "Candidate": {
      "type": "object",
      "description": "导入者私有的不可变候选版本，不代表审核或发布。",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "archiveBytes",
        "createdAt",
        "mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "候选UUID。",
          "pattern": "^[a-f0-9-]{36}$"
        },
        "digest": {
          "type": "string",
          "description": "规范资产清单SHA256。",
          "pattern": "^[a-f0-9]{64}$"
        },
        "archiveBytes": {
          "type": "integer",
          "description": "原ZIP字节数。",
          "minimum": 0,
          "maximum": 8388608
        },
